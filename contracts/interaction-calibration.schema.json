{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auaka.local/contracts/interaction-calibration.v1.schema.json",
  "title": "Auaka interaction calibration profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile_id", "coordinates", "tracking", "pointer", "pinch", "open_palm", "two_hand"],
  "properties": {
    "version": { "const": 1 },
    "profile_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "coordinates": {
      "type": "object", "additionalProperties": false,
      "required": ["preview_mirrored", "interaction_mirror_x"],
      "properties": {
        "preview_mirrored": { "const": true },
        "interaction_mirror_x": { "const": true }
      }
    },
    "tracking": {
      "type": "object", "additionalProperties": false,
      "required": ["min_confidence", "dropout_grace_ms", "auto_exit_ms"],
      "properties": {
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "dropout_grace_ms": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "auto_exit_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 }
      }
    },
    "pointer": {
      "type": "object", "additionalProperties": false,
      "required": ["min_cutoff", "beta", "derivative_cutoff", "deadzone_px", "cursor_diameter_px", "hit_radius_px"],
      "properties": {
        "min_cutoff": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "beta": { "type": "number", "minimum": 0, "maximum": 10 },
        "derivative_cutoff": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "deadzone_px": { "type": "number", "minimum": 0, "maximum": 100 },
        "cursor_diameter_px": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "hit_radius_px": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 }
      }
    },
    "pinch": {
      "type": "object", "additionalProperties": false,
      "required": ["enter_ratio", "release_ratio", "activation_ms", "cooldown_ms", "palm_epsilon"],
      "properties": {
        "enter_ratio": { "type": "number", "minimum": 0, "maximum": 2 },
        "release_ratio": { "type": "number", "minimum": 0, "maximum": 2 },
        "activation_ms": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "palm_epsilon": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "open_palm": {
      "type": "object", "additionalProperties": false,
      "required": ["activation_ms", "cooldown_ms"],
      "properties": {
        "activation_ms": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 5000 }
      }
    },
    "two_hand": {
      "type": "object", "additionalProperties": false,
      "required": ["activation_ms", "zoom_deadzone_ratio", "rotation_deadzone_degrees", "max_zoom_rate_per_second", "max_rotation_rate_degrees_per_second", "dropout_grace_ms"],
      "properties": {
        "activation_ms": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "zoom_deadzone_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation_deadzone_degrees": { "type": "number", "minimum": 0, "maximum": 180 },
        "max_zoom_rate_per_second": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        "max_rotation_rate_degrees_per_second": { "type": "number", "exclusiveMinimum": 0, "maximum": 1080 },
        "dropout_grace_ms": { "type": "integer", "minimum": 0, "maximum": 2000 }
      }
    }
  }
}
