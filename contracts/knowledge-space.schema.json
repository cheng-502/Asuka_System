{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auaka.system/schemas/knowledge-space.schema.json",
  "title": "Auaka System Knowledge Space Artifact",
  "description": "Strict versioned browser-safe projections of an Obsidian knowledge space.",
  "oneOf": [
    { "$ref": "#/$defs/artifactV1" },
    { "$ref": "#/$defs/artifactV2" }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "dimension", "metric", "normalized"],
      "properties": {
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "dimension": { "type": "integer", "minimum": 1 },
        "metric": { "const": "cosine" },
        "normalized": { "type": "boolean" },
        "revision": { "type": "string" },
        "device": { "type": "string" },
        "runtime_device": { "type": "string" }
      }
    },
    "umap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_components", "random_state", "metric"],
      "properties": {
        "n_components": { "const": 3 },
        "random_state": { "type": "integer" },
        "metric": { "const": "cosine" },
        "n_neighbors": { "type": "integer", "minimum": 1 },
        "min_dist": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault_hash", "note_count"],
      "properties": {
        "vault_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "note_count": { "type": "integer", "minimum": 0 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "layoutsV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic", "galaxy", "compact"],
      "properties": {
        "semantic": { "$ref": "#/$defs/position" },
        "galaxy": { "$ref": "#/$defs/position" },
        "compact": { "$ref": "#/$defs/position" }
      }
    },
    "hierarchyV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "parent_id", "depth", "assignment", "topic_root_id"],
      "properties": {
        "role": { "enum": ["hub", "note"] },
        "parent_id": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "depth": { "type": "integer", "minimum": 0 },
        "assignment": {
          "enum": ["explicit", "wikilink", "folder", "semantic", "unassigned"]
        },
        "topic_root_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "layoutAlgorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed"],
      "properties": {
        "algorithm": { "$ref": "#/$defs/nonEmptyString" },
        "seed": { "type": "integer" }
      }
    },
    "layoutGenerationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "galaxy", "compact"],
      "properties": {
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "galaxy": { "$ref": "#/$defs/layoutAlgorithm" },
        "compact": { "$ref": "#/$defs/layoutAlgorithm" }
      }
    },
    "nodeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "domain", "position", "explicit_link_count"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "type": "string" },
        "domain": { "$ref": "#/$defs/nonEmptyString" },
        "position": { "$ref": "#/$defs/position" },
        "explicit_link_count": { "type": "integer", "minimum": 0 }
      }
    },
    "nodeV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "domain", "layouts", "hierarchy", "explicit_link_count"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!virtual:).+"
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "type": "string" },
        "domain": { "$ref": "#/$defs/nonEmptyString" },
        "layouts": { "$ref": "#/$defs/layoutsV2" },
        "hierarchy": { "$ref": "#/$defs/hierarchyV2" },
        "explicit_link_count": { "type": "integer", "minimum": 0 }
      }
    },
    "virtualNodeV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "layouts", "hierarchy"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^virtual:.+"
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "layouts": { "$ref": "#/$defs/layoutsV2" },
        "hierarchy": { "$ref": "#/$defs/hierarchyV2" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "types"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["wikilink", "semantic"] }
        },
        "similarity": { "type": "number", "minimum": -1, "maximum": 1 },
        "is_unresolved": { "type": "boolean" },
        "unresolved_target": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "types": { "type": "array", "contains": { "const": "semantic" } }
            }
          },
          "then": { "required": ["similarity"] }
        },
        {
          "if": {
            "required": ["is_unresolved"],
            "properties": { "is_unresolved": { "const": true } }
          },
          "then": { "required": ["unresolved_target"] }
        }
      ]
    },
    "artifactV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generated_at", "pipeline", "embedding", "umap", "source", "nodes", "links"],
      "properties": {
        "version": { "const": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "pipeline": { "$ref": "#/$defs/pipeline" },
        "embedding": { "$ref": "#/$defs/embedding" },
        "umap": { "$ref": "#/$defs/umap" },
        "source": { "$ref": "#/$defs/source" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/nodeV1" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "artifactV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generated_at", "pipeline", "embedding", "umap", "layout_generation", "source", "nodes", "virtual_nodes", "links"],
      "properties": {
        "version": { "const": 2 },
        "generated_at": { "type": "string", "format": "date-time" },
        "pipeline": { "$ref": "#/$defs/pipeline" },
        "embedding": { "$ref": "#/$defs/embedding" },
        "umap": { "$ref": "#/$defs/umap" },
        "layout_generation": { "$ref": "#/$defs/layoutGenerationV2" },
        "source": { "$ref": "#/$defs/source" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/nodeV2" } },
        "virtual_nodes": { "type": "array", "items": { "$ref": "#/$defs/virtualNodeV2" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    }
  }
}
