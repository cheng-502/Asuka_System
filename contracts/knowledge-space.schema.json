{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auaka.system/schemas/knowledge-space.schema.json",
  "title": "Auaka System Knowledge Space Artifact",
  "description": "Versioned, browser-safe projection of an Obsidian knowledge space.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "pipeline",
    "embedding",
    "umap",
    "source",
    "nodes",
    "links"
  ],
  "properties": {
    "version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "pipeline": { "$ref": "#/$defs/pipeline" },
    "embedding": { "$ref": "#/$defs/embedding" },
    "umap": { "$ref": "#/$defs/umap" },
    "source": { "$ref": "#/$defs/source" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "dimension", "metric", "normalized"],
      "properties": {
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "dimension": { "type": "integer", "minimum": 1 },
        "metric": { "const": "cosine" },
        "normalized": { "type": "boolean" },
        "revision": { "type": "string" },
        "device": { "type": "string" },
        "runtime_device": { "type": "string" }
      }
    },
    "umap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_components", "random_state", "metric"],
      "properties": {
        "n_components": { "const": 3 },
        "random_state": { "type": "integer" },
        "metric": { "const": "cosine" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault_hash", "note_count"],
      "properties": {
        "vault_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "note_count": { "type": "integer", "minimum": 0 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "domain",
        "position",
        "explicit_link_count"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "type": "string" },
        "domain": { "$ref": "#/$defs/nonEmptyString" },
        "position": { "$ref": "#/$defs/position" },
        "explicit_link_count": { "type": "integer", "minimum": 0 }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "types"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["wikilink", "semantic"] }
        },
        "similarity": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "is_unresolved": { "type": "boolean" },
        "unresolved_target": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "types": {
                "type": "array",
                "contains": { "const": "semantic" }
              }
            }
          },
          "then": {
            "required": ["similarity"],
            "properties": {
              "similarity": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "required": ["is_unresolved"],
            "properties": { "is_unresolved": { "const": true } }
          },
          "then": {
            "required": ["unresolved_target"],
            "properties": {
              "unresolved_target": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      ]
    }
  }
}
